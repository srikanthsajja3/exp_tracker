<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="quick_add"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_add_expense_short"
        android:shortcutLongLabel="@string/shortcut_add_expense_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.expensetracker.app"
            android:targetClass="com.expensetracker.app.QuickAddActivity"
            android:data="expensetracker://quick-add" />
    </shortcut>
    <shortcut
        android:shortcutId="scan_sms"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_scan_sms_short"
        android:shortcutLongLabel="@string/shortcut_scan_sms_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.expensetracker.app"
            android:targetClass="com.expensetracker.app.MainActivity"
            android:data="expensetracker://scan-sms" />
    </shortcut>
</shortcuts>
